+        assert_eq!(before, GapParentSnapshot::capture(&bank, "during-actual-after-tool-hook"));
+        fs::write(bank.directory.join("gap-held-bash-hook-observation.json"),
+            serde_json::to_vec_pretty(&json!({"child":child,"reached":reached,"proof":proof,"parentBytesEqual":true})).unwrap()).unwrap();
+        fs::write(bank.directory.join("frontiers/bash-hook.release"), b"complete the same real Core callback").unwrap();
+    };
+    let ((receipts, teardown), ()) = tokio::join!(driving, observing);
+    let released = result(&receipts, 3);
+    assert_eq!(released["releaseReceipt"]["status"], "released");
+    assert_eq!(released["cwdExists"], false);
+    assert!(released["releaseError"].is_null());
