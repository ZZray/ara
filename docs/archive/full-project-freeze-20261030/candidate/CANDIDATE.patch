+        })).unwrap()).unwrap();
+        let up = RoutedUpstream::start(
+            &bank.directory,
+            vec![
+                call("g3-gap-startup-task", "task", task_args("g3-task-a", "Exercise the original post-allocation startup failure frontier.")),
+                answer("The original Task startup failure was reported."),
+            ],
+            vec![], vec![],
+        ).await;
+        let mut command = bank.command(&up.url(), "rpc");
+        command.env("ARA_TEST_PEER_FRONTIERS", &config);
+        let mut process = WireProcess::spawn(command, &bank.directory);
+        process.until(|frame| frame["type"] == "ready").await;
+        let before = GapParentSnapshot::capture(&bank, "before-dispatch");
+        process.rpc("gap-startup-prompt", "prompt", json!({"message":"Run the prescribed isolated Task once."})).await;
+        let reached_path = bank.directory.join("frontiers/materialized.reached.json");
+        gap_wait_file(&reached_path).await;
+        let reached: Value = serde_json::from_slice(&fs::read(&reached_path).unwrap()).unwrap();
+        let materialized: Value = serde_json::from_str(reached["identity"].as_str().unwrap()).unwrap();
+        let resource = &materialized["resource"];
+        let cwd = PathBuf::from(materialized["cwd"].as_str().unwrap());
+        let resource_id = resource["resource_id"].as_str().unwrap();
+        assert_eq!(materialized["actor_spawned"], false);
+        assert!(cwd.is_dir(), "the actual backend must be materialized before this fault");
+        let marker: Value = serde_json::from_slice(&fs::read(cwd.parent().unwrap().join("owner.json")).unwrap()).unwrap();
+        assert_eq!(marker["resource_id"], resource_id);
+        assert!(resource["peer"].is_null(), "the materialized lease must not already be adopted");
+        assert_eq!(up.counts(), [1, 0, 0]);
+        assert_eq!(before, GapParentSnapshot::capture(&bank, "materialized-before-spawn"));
+        fs::write(bank.directory.join("frontiers/materialized.release"), b"continue the original preparation").unwrap();
+        process.until(|frame| frame["type"] == "agent_end").await;
