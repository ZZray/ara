+fn gap_files_named(root: &Path, name: &str) -> Vec<PathBuf> {
+    fn visit(directory: &Path, name: &str, found: &mut Vec<PathBuf>) {
+        for entry in fs::read_dir(directory).unwrap() {
+            let entry = entry.unwrap();
+            if entry.file_type().unwrap().is_dir() {
+                visit(&entry.path(), name, found);
+            } else if entry.file_name() == std::ffi::OsStr::new(name) {
+                found.push(entry.path());
+            }
+        }
+    }
+    let mut found = Vec::new();
+    if root.is_dir() {
+        visit(root, name, &mut found);
+    }
+    found.sort();
+    found
+}
