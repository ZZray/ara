+        return Ok(());
+    };
+    let bytes = match fs::read(&config_path) {
+        Ok(bytes) => bytes,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(()),
+        Err(error) => return Err(error.into()),
+    };
+    let config: serde_json::Value = serde_json::from_slice(&bytes)?;
+    for gate in config["gates"].as_array().into_iter().flatten() {
+        if gate["name"].as_str() != Some(name)
+            || !identity.contains(gate["identityContains"].as_str().unwrap_or(""))
+        {
+            continue;
+        }
+        let key = gate["key"].as_str().context("Frontier gate key missing")?;
+        anyhow::ensure!(
+            !key.is_empty() && key.chars().all(|c| c.is_ascii_alphanumeric() || c == '-' || c == '_'),
+            "Invalid private frontier gate key"
+        );
+        static COUNTS: OnceLock<Mutex<HashMap<String, u64>>> = OnceLock::new();
+        let occurrence = {
+            let mut counts = COUNTS.get_or_init(Default::default).lock().unwrap_or_else(|e| e.into_inner());
+            let count = counts.entry(key.into()).or_default();
+            *count += 1;
+            *count
+        };
+        if occurrence != gate["occurrence"].as_u64().unwrap_or(1) {
+            continue;
+        }
+        let dir = config_path.parent().context("Private frontier config directory missing")?.join("frontiers");
+        fs::create_dir_all(&dir)?;
+        fs::write(
+            dir.join(format!("{key}.reached.json")),
+            serde_json::to_vec_pretty(&serde_json::json!({
+                "name": name, "identity": identity, "occurrence": occurrence,
+                "at": crate::host_peers::now_ms(), "details": details
+            }))?,
+        )?;
+        let started = std::time::Instant::now();
+        while !dir.join(format!("{key}.release")).is_file() {
+            anyhow::ensure!(
+                started.elapsed() < std::time::Duration::from_secs(25),
+                "Actual {name} frontier remained held; original effect requires reconciliation, no replay"
+            );
+            std::thread::sleep(std::time::Duration::from_millis(5));
+        }
