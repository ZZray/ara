+#[derive(Debug, PartialEq, serde::Serialize)]
+struct GapParentSnapshot {
+    head: Vec<u8>,
+    raw_index: Vec<u8>,
+    staged_binary_diff: Vec<u8>,
+    unstaged_binary_diff: Vec<u8>,
+    untracked: std::collections::BTreeMap<String, Vec<u8>>,
+}
+impl GapParentSnapshot {
+    fn capture(bank: &Bank, label: &str) -> Self {
+        let observe = |args: &[&str]| {
+            let output = std::process::Command::new("git")
+                .current_dir(&bank.project)
+                .env_remove("GIT_DIR")
+                .env_remove("GIT_WORK_TREE")
+                .env_remove("GIT_INDEX_FILE")
+                .env("GIT_OPTIONAL_LOCKS", "0")
+                .args(["-c", "diff.autoRefreshIndex=false"])
+                .args(args)
+                .output()
+                .unwrap();
+            assert!(output.status.success(), "{args:?}: {}", String::from_utf8_lossy(&output.stderr));
+            output.stdout
+        };
+        let paths = observe(&["ls-files", "--others", "--exclude-standard", "-z"]);
+        fn untracked_bytes(project: &Path, relative: &Path, out: &mut std::collections::BTreeMap<String, Vec<u8>>) {
+            let path = project.join(relative);
+            if path.is_dir() {
+                for entry in fs::read_dir(&path).unwrap() {
+                    let entry = entry.unwrap();
+                    // Embedded repositories are reported as directories by ls-files.
+                    // Their Git administration is not untracked worktree content.
+                    if entry.file_name() != std::ffi::OsStr::new(".git") {
+                        untracked_bytes(project, &relative.join(entry.file_name()), out);
+                    }
+                }
+            } else {
+                out.insert(relative.to_string_lossy().into_owned(), fs::read(&path).unwrap());
+            }
+        }
+        let mut untracked = std::collections::BTreeMap::new();
+        for path in paths.split(|byte| *byte == 0).filter(|path| !path.is_empty()) {
+            let path = String::from_utf8(path.to_vec()).expect("controlled fixture paths are scalar UTF-8");
+            untracked_bytes(&bank.project, Path::new(&path), &mut untracked);
+        }
+        let snapshot = Self {
+            head: observe(&["rev-parse", "HEAD"]),
+            raw_index: fs::read(bank.project.join(".git/index")).unwrap(),
+            staged_binary_diff: observe(&["diff", "--binary", "--no-ext-diff", "--cached"]),
+            unstaged_binary_diff: observe(&["diff", "--binary", "--no-ext-diff"]),
+            untracked,
+        };
+        let directory = bank.directory.join("parent-byte-snapshots").join(label);
+        fs::create_dir_all(&directory).unwrap();
+        fs::write(directory.join("HEAD.stdout"), &snapshot.head).unwrap();
+        fs::write(directory.join("index.bin"), &snapshot.raw_index).unwrap();
+        fs::write(directory.join("staged.patch"), &snapshot.staged_binary_diff).unwrap();
+        fs::write(directory.join("unstaged.patch"), &snapshot.unstaged_binary_diff).unwrap();
+        fs::write(directory.join("snapshot.json"), serde_json::to_vec_pretty(&snapshot).unwrap()).unwrap();
+        snapshot
+    }
+}
