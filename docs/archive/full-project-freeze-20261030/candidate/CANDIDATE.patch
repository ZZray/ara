+async fn gap_cancel_live_bash() {
+    let bank = Bank::new("g3-gap-cancel-live-bash", "patch", false, false, false, false);
+    gap_enable_async_bash(&bank);
+    let up = RoutedUpstream::start(
+        &bank.directory,
+        vec![
+            call("g3-gap-cancel-task", "task", task_args("g3-task-a", "Run the prescribed actual async Bash job.")),
+            answer("The original cancellation result was observed."),
+        ], gap_bash_responses(), vec![],
+    ).await;
+    let mut process = WireProcess::spawn(bank.command(&up.url(), "rpc"), &bank.directory);
+    process.until(|frame| frame["type"] == "ready").await;
+    let before = GapParentSnapshot::capture(&bank, "before-dispatch");
+    process.rpc("gap-cancel-prompt", "prompt", json!({"message":"Invoke the actual isolated Task."})).await;
+    let child = gap_actual_child(&bank).await;
+    let cwd = PathBuf::from(child["header"]["cwd"].as_str().unwrap());
+    gap_wait_file(&cwd.join("bash-live-started.txt")).await;
+    assert!(!cwd.join("bash-finished.txt").exists());
+    assert!(gap_files_named(&bank.home.join("sessions"), "capture.json").is_empty());
+    let cancelled = process.rpc("gap-real-peer-cancel", "peer_control",
+        json!({"operation":"cancel","target":child["id"]})).await;
+    assert_eq!(cancelled["cancelled"], true, "actual child cancel must reach its live original owner");
+    process.until(|frame| frame["type"] == "agent_end").await;
+    let releases = gap_files_named(&bank.home.join("sessions"), "release.json");
+    assert_eq!(releases.len(), 1);
+    let release: Value = serde_json::from_slice(&fs::read(&releases[0]).unwrap()).unwrap();
+    let frames = gap_finish(process, &bank, release["status"] == "released").await;
+    if release["status"] == "released" {
+        assert!(!cwd.exists());
+        assert!(release["error"].is_null());
+        let patch = fs::read_to_string(release["capture"]["patch_path"].as_str().unwrap()).unwrap();
+        assert!(patch.contains("bash-live-started.txt"));
+        assert!(!patch.contains("bash-finished.txt"), "cancelled live Bash ran past its gate");
+    } else {
+        assert_eq!(release["status"], "retained");
+        assert!(release["error"].as_str().is_some_and(|error| {
+            let error = error.to_ascii_lowercase();
+            error.contains("unknown") || error.contains("unsettled") || error.contains("reconciliation")
+        }));
+        assert!(cwd.is_dir(), "Unknown cancellation must retain its exact materialized workspace");
+    }
+    let journals = actual_journals(&bank);
+    let result = journals.iter().flat_map(|journal| journal["rows"].as_array().unwrap())
+        .find(|message| message["role"] == "toolResult" && message["toolCallId"] == "g3-gap-cancel-task").unwrap();
+    assert_eq!(result["isError"], true);
+    assert_eq!(result["details"]["results"][0]["taskAccepted"], false);
+    assert_eq!(before, GapParentSnapshot::capture(&bank, "after-actual-peer-cancel"));
+    fs::write(bank.directory.join("gap-live-cancel-assertions.json"), serde_json::to_vec_pretty(&json!({
+        "criteria":["M8","O8"],"actualCancel":cancelled,"originalChild":child,
+        "release":release,"frames":frames,"journals":journals,"scope":"Peer hard cancel of a live Task/Bash owner, not an OS sandbox claim"
+    })).unwrap()).unwrap();
+}
