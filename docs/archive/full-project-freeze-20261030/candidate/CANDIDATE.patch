+async fn gap_actual_child(bank: &Bank) -> Value {
+    tokio::time::timeout(Duration::from_secs(25), async {
+        loop {
+            if let Some(child) = actual_journals(bank).into_iter().find(|journal| journal["init"]["isolated"] == true) {
+                return child;
+            }
+            tokio::time::sleep(Duration::from_millis(5)).await;
+        }
+    }).await.expect("ordinary Task did not create its actual isolated journal")
