+fn gap_enable_async_bash(bank: &Bank) {
+    let settings_path = bank.home.join("agent/config.yml");
+    let mut settings: Value = serde_json::from_slice(&fs::read(&settings_path).unwrap()).unwrap();
+    settings["async"]["enabled"] = true.into();
+    fs::write(settings_path, serde_json::to_vec_pretty(&settings).unwrap()).unwrap();
+    let agent_file = bank.project.join(".ara/agents/g3-task-a.md");
+    let source = fs::read_to_string(&agent_file).unwrap();
+    fs::write(agent_file, source.replacen("tools: write, bash", "tools: write, bash, wait\nblocking: true", 1)).unwrap();
+}
