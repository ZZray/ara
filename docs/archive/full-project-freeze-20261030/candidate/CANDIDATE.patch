+    assert_eq!(capture["resource_id"], held["proof"]["resource_id"]);
+    let effect_paths = gap_files_named(&bank.home.join("sessions"), "release.json");
+    assert_eq!(effect_paths.len(), 1, "dropped release observer must join the same retained resource");
+    assert_eq!(before, GapParentSnapshot::capture(&bank, "after-hook-and-release"));
+    bank.preserved_wip();
+    fs::write(bank.directory.join("gap-bash-hook-assertions.json"), serde_json::to_vec_pretty(&json!({
+        "criteria":["M8","O8"],"proofBoundary":"actual Core callback await, not OMP extension product acceptance",
+        "receipts":receipts,"teardown":teardown,"sameResource":held["proof"]["resource_id"]
