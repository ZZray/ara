+        let release_paths = gap_files_named(&bank.home.join("sessions"), "release.json");
+        assert_eq!(release_paths.len(), 1, "one original resource must own the startup outcome");
+        let release: Value = serde_json::from_slice(&fs::read(&release_paths[0]).unwrap()).unwrap();
+        assert_eq!(release["resource_id"], resource_id);
+        if reject_attachment {
+            let rejected: Value = serde_json::from_slice(&fs::read(bank.directory.join("task-rejected-pending-attachment.json")).unwrap()).unwrap();
+            assert_eq!(rejected["resource_before"]["resource_id"], resource_id);
+            assert_eq!(rejected["resource_before"]["sealed"], false);
+            assert_eq!(rejected["resource_after_seal"]["sealed"], true);
+            assert!(rejected["registered_child_before"].is_null());
+            assert_eq!(release["status"], "retained");
+            assert!(release["error"].as_str().unwrap().contains("startup/join outcome requires reconciliation"));
+            assert!(release["capture"].is_null());
+            assert!(cwd.is_dir(), "unknown post-spawn outcome must retain the original workspace");
+        } else {
