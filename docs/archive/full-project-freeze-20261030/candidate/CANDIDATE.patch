+async fn gap_bash_hook_and_observer() {
+    let bank = Bank::new("g3-gap-bash-hook-owner", "patch", false, true, false, false);
+    gap_enable_async_bash(&bank);
+    fs::write(bank.directory.join("frontiers.json"), serde_json::to_vec_pretty(&json!({
+        "gates":[{"name":"task-after-tool-hook","key":"bash-hook","identityContains":"|g3-gap-bash-wait|wait","occurrence":1}]
+    })).unwrap()).unwrap();
+    let up = RoutedUpstream::start(
+        &bank.directory,
+        vec![
+            call("g3-gap-hook-task", "task", task_args("g3-task-a", "Run the actual async Bash job and consume its result through Native Wait.")),
+            answer("The original Task has completed its owned work."),
+        ],
+        gap_bash_responses(), vec![],
+    ).await;
+    let before = GapParentSnapshot::capture(&bank, "before-dispatch");
+    let driving = fixture(&bank, &up, vec![
+        json!({"op":"root_prompt","text":"Invoke the actual Task once."}),
+        json!({"op":"task_alias","alias":"gap-worker"}),
+        json!({"op":"task_snapshot","alias":"gap-worker"}),
+        json!({"op":"task_release","alias":"gap-worker","observerDrop":true}),
+    ]);
+    let observing = async {
+        let child = gap_actual_child(&bank).await;
+        let cwd = PathBuf::from(child["header"]["cwd"].as_str().unwrap());
+        gap_wait_file(&cwd.join("bash-live-started.txt")).await;
+        assert!(!cwd.join("bash-finished.txt").exists());
+        assert!(gap_files_named(&bank.home.join("sessions"), "capture.json").is_empty());
+        assert!(gap_files_named(&bank.home.join("sessions"), "release.json").is_empty());
+        assert_eq!(before, GapParentSnapshot::capture(&bank, "during-actual-bash"));
+        fs::write(cwd.join("bash-live-release"), b"finish the same original OS process").unwrap();
+        let gate = bank.directory.join("frontiers/bash-hook.reached.json");
+        gap_wait_file(&gate).await;
+        let reached: Value = serde_json::from_slice(&fs::read(gate).unwrap()).unwrap();
+        let details = &reached["details"];
+        assert_eq!(details["cwd"], json!(cwd));
+        assert_eq!(details["tool_call_id"], "g3-gap-bash-wait");
+        assert_eq!(details["tool_name"], "wait");
+        assert_eq!(details["is_error"], false);
+        assert_eq!(fs::read(cwd.join("bash-finished.txt")).unwrap(), b"settled\n");
+        let proof_path = PathBuf::from(details["proof_path"].as_str().unwrap());
+        let proof: Value = serde_json::from_slice(&fs::read(&proof_path).unwrap()).unwrap();
+        assert_eq!(proof["phase"], "held");
+        assert_eq!(proof["resource_id"], details["resource_id"]);
+        assert!(cwd.is_dir());
+        assert!(gap_files_named(&bank.home.join("sessions"), "capture.json").is_empty(),
+            "Task captured while its real Core after-tool callback was still held");
